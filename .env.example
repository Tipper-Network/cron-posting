# Copy to .env. Do not commit .env.
# Dokploy: set these on the API service only. The web service does not need secrets.

# Host ports for docker compose. Inside the API container, compose sets API_PORT=3001.
API_PORT=3101
WEB_PORT=3100
API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101

# Public URLs used for OAuth redirect_uri and post-login return.
PUBLIC_API_URL=https://api.cron-posting.psyferblock.io
PUBLIC_WEB_URL=https://cron-posting.psyferblock.io

# Shared secret for Connect buttons. Required to start /oauth/youtube and /oauth/instagram.
OAUTH_GATE=

# Optional override. Default: {S3_PREFIX}/secrets/oauth-tokens.json
# OAUTH_TOKEN_S3_KEY=socials/secrets/oauth-tokens.json

# Google Sheet. Prefer a service account JSON shared on the spreadsheet.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=publish_catalog
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sheets-service-account.json
# Legacy user OAuth (avoid — refresh tokens die in Testing):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# S3. Local pipeline uploads the mp4. This service reads media and stores OAuth tokens.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=socials.bucket
S3_PREFIX=socials

# Instagram Graph. Connect via /oauth/instagram?gate=… (stores long-lived token in S3).
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ID=
IG_COLLABORATORS=tipper.network,thehardport
IG_SHARE_TO_FEED=false
# Optional fallback until Connect runs:
# META_ACCESS_TOKEN=

# YouTube Data API. Use a Web OAuth client with redirect:
#   {PUBLIC_API_URL}/oauth/youtube/callback
# Consent screen must be In production. Then Connect once.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=UCKUS5W72IDOrWnhh-4wOxSw
YOUTUBE_CATEGORY_ID=22
# Optional fallback until Connect runs:
# YOUTUBE_REFRESH_TOKEN=
