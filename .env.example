# Copy to .env. Do not commit .env.
# Dokploy: set these on the API service only. The web service does not need them.

# Host ports for docker compose. Inside the API container, compose sets API_PORT=3001.
API_PORT=3101
WEB_PORT=3100
API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101

# Google Sheet, read and write. Service account JSON, a key file, or the OAuth refresh token.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=publish_catalog
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sheets-service-account.json
# GOOGLE_OAUTH_TOKEN_PATH=/secrets/sheets-token.json
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# S3. Local pipeline uploads the mp4. This service only reads it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=socials.bucket
S3_PREFIX=socials

# Instagram Graph. Token lasts about 60 days.
META_ACCESS_TOKEN=
IG_BUSINESS_ID=
IG_COLLABORATORS=tipper.network,thehardport
IG_SHARE_TO_FEED=false

# YouTube Data API. Refresh token, or a token file from the channel login.
# YOUTUBE_TOKEN_PATH=/secrets/youtube-token.json
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=UCKUS5W72IDOrWnhh-4wOxSw
YOUTUBE_CATEGORY_ID=22
