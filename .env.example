# Copy to .env. Do not commit .env.

# Host ports. 3000/3001 are used by The Hard Port on this machine.
API_PORT=3101
WEB_PORT=3100
# Browser and Next server. Inside Docker Compose the web container uses http://api:3001.
API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101

# Google Sheet (read). Prefer a service account shared as Viewer/Editor.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=publish_catalog
# One of:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sheets-service-account.json
# Or the existing OAuth token from the pipeline machine:
# GOOGLE_OAUTH_TOKEN_PATH=/secrets/sheets-token.json

# S3 media host (same bucket the Instagram publisher fetches from)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=socials.bucket
S3_PREFIX=socials/
